{
  "parsers": {
    "**/*.mjs": "es6",
    "**/*.ts": "typescript",
    "**/*.mts": "typescript"
  },
  "ignores": [
    "@lavamoat/allow-scripts",
    "@lavamoat/preinstall-always-fail",
    "@types/*",
    "@yarnpkg/types",
    "eslint-plugin-n",
    "oxlint-tsgolint",
    "@swc/cli",
    "@swc/core",
    "ts-node",
    "typedoc",
    "@actions/core",
    "@actions/github"
  ]
}
