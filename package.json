{
  "name": "@metamask/github-tools",
  "version": "1.22.2",
  "private": true,
  "description": "Tools for interacting with the GitHub API to do metrics gathering",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/github-tools.git"
  },
  "scripts": {
    "changelog:check": "node --loader ts-node/esm src/changelog-check.mts",
    "count-references-to-contributor-docs": "ts-node --swc src/scripts/count-references-to-contributor-docs/cli.ts",
    "gen:commits": "node .github/scripts/generate-rc-commits.mjs",
    "get-review-metrics": "ts-node src/get-review-metrics.ts",
    "lint": "yarn lint:tsc && yarn lint:oxlint && yarn lint:constraints && yarn lint:misc --check && yarn lint:dependencies --check",
    "lint:constraints": "yarn constraints",
    "lint:changelog": "auto-changelog validate --prettier",
    "lint:dependencies": "depcheck && yarn dedupe",
    "lint:fix": "yarn lint:oxlint --fix && yarn lint:constraints --fix && yarn lint:misc --write && yarn lint:dependencies",
    "lint:misc": "prettier '**/*.json' '**/*.md' '**/*.yml' '*.{js,cjs,mjs,ts,mts}' 'src/**/*.{ts,mts}' '.github/scripts/**/*.mts' '.github/actions/draft-segment-schema-pr/**/*.mjs' '!.yarnrc.yml' '!.cursor/**' '!oxlint-suppressions.json' --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint:tsc": "tsc",
    "segment-schema:draft-pr": "ts-node src/segment-schema-draft-pr/cli.ts",
    "slack:release-testing": "node .github/scripts/slack-release-testing.mjs",
    "test": "jest && node --test '.github/**/*.test.{mjs,mts}' && jest-it-up",
    "test:watch": "jest --watch",
    "update-release-sheet": "node .github/scripts/update-release-sheet.mjs",
    "lint:oxlint": "oxlint"
  },
  "dependencies": {
    "@metamask/auto-changelog": "^7.0.1",
    "@metamask/utils": "^7.1.0",
    "@octokit/graphql": "^7.0.1",
    "@octokit/request": "^8.1.1",
    "@octokit/rest": "^19.0.13",
    "@slack/web-api": "^6.0.0",
    "@slack/webhook": "^7.0.6",
    "@types/luxon": "^3.3.0",
    "axios": "^0.24.0",
    "csv-parse": "5.6.0",
    "execa": "^9.5.2",
    "googleapis": "144.0.0",
    "luxon": "^3.3.0",
    "ora": "^5.4.1",
    "semver": "^7.7.2",
    "simple-git": "3.27.0",
    "typescript": "^5.1.3",
    "unzipper": "^0.12.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^2.3.1",
    "@lavamoat/preinstall-always-fail": "^1.0.0",
    "@metamask/oxlint-config": "^0.1.1",
    "@metamask/oxlint-config-commonjs": "^0.1.1",
    "@metamask/oxlint-config-nodejs": "^0.1.1",
    "@metamask/oxlint-config-typescript": "^0.1.1",
    "@metamask/oxlint-config-vitest": "^0.1.1",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.80",
    "@types/jest": "^28.1.6",
    "@types/node": "^22.13.14",
    "@types/semver": "^7",
    "@types/unzipper": "^0",
    "@yarnpkg/types": "^4.0.0",
    "depcheck": "^1.4.3",
    "eslint-plugin-n": "^18.3.0",
    "jest": "^28.1.3",
    "jest-it-up": "^2.0.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.1"
  },
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@swc/core": false
    }
  }
}
