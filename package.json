{
  "name": "@metamask/github-tools",
  "version": "1.22.2",
  "private": true,
  "description": "Tools for interacting with the GitHub API to do metrics gathering",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/github-tools.git"
  },
  "scripts": {
    "changelog:check": "node --loader ts-node/esm src/changelog-check.mts",
    "count-references-to-contributor-docs": "ts-node --swc src/scripts/count-references-to-contributor-docs/cli.ts",
    "gen:commits": "node .github/scripts/generate-rc-commits.mjs",
    "get-review-metrics": "ts-node src/get-review-metrics.ts",
    "lint": "yarn lint:tsc && yarn lint:oxlint && yarn lint:constraints && yarn lint:misc --check && yarn lint:dependencies --check",
    "lint:changelog": "auto-changelog validate --formatter oxfmt",
    "lint:constraints": "yarn constraints",
    "lint:dependencies": "knip --config knip.config.mts --dependencies && yarn dedupe",
    "lint:fix": "yarn lint:oxlint --fix && yarn lint:constraints --fix && yarn lint:misc --write && yarn lint:dependencies",
    "lint:misc": "oxfmt --ignore-path .gitignore",
    "lint:oxlint": "oxlint",
    "lint:tsc": "tsc",
    "segment-schema:draft-pr": "ts-node src/segment-schema-draft-pr/cli.ts",
    "slack:release-testing": "node .github/scripts/slack-release-testing.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "update-release-sheet": "node .github/scripts/update-release-sheet.mjs"
  },
  "dependencies": {
    "@metamask/auto-changelog": "^7.1.0",
    "@metamask/utils": "^7.1.0",
    "@octokit/graphql": "^7.0.1",
    "@octokit/request": "^8.1.1",
    "@octokit/rest": "^19.0.13",
    "@slack/web-api": "^8.3.0",
    "@slack/webhook": "^8.0.2",
    "@types/luxon": "^3.7.6",
    "axios": "^1.21.0",
    "csv-parse": "^7.0.3",
    "execa": "^10.2.1",
    "googleapis": "^189.0.0",
    "luxon": "^3.7.2",
    "ora": "^5.4.1",
    "semver": "^7.8.6",
    "simple-git": "^4.0.2",
    "typescript": "^6.0.3",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.1",
    "@metamask/oxlint-config": "^0.2.0",
    "@metamask/oxlint-config-commonjs": "^0.2.0",
    "@metamask/oxlint-config-nodejs": "^0.2.0",
    "@metamask/oxlint-config-typescript": "^0.2.0",
    "@metamask/oxlint-config-vitest": "^0.2.0",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.80",
    "@types/node": "^22.13.14",
    "@types/semver": "^7.8.0",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@yarnpkg/types": "^4.0.1",
    "eslint-plugin-n": "^18.5.0",
    "knip": "^6.39.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "ts-node": "^10.9.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.17.1",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@swc/core": false
    }
  }
}
